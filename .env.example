# Copy to .env for local development. Set the same variables in Cloudflare Pages
# (Settings → Environment variables) for Production and Preview.

# Formspree form ID — the part after https://formspree.io/f/
PUBLIC_FORMSPREE_ID=

# Analytics (defaults to the IDs the Webflow site used; set to empty to disable)
# PUBLIC_GA_MEASUREMENT_ID=G-2Q1TKWSXXE
# PUBLIC_GOOGLE_ADS_ID=AW-16638870571

# Only needed to re-run `npm run export:webflow`. Never commit a real value.
# WEBFLOW_API_TOKEN=
# PRIVATE_EXPORT_DIR=../webflow-private-export
