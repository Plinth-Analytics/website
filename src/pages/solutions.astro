---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import CtaBand from '../components/CtaBand.astro';
import { solutions } from '../data/solutions';
---

<Base
  title="Solutions"
  description="Forge, Fulcrum, ARC, Feature Studio and Pocket Analyst: custom solutions from Plinth for working with real-world healthcare data."
>
  <PageHero eyebrow="Solutions" title="Custom Solutions that Fit You Best">
    <nav aria-label="Solutions on this page" class="jump">
      <ul>{solutions.map((s) => <li><a href={`#${s.id}`}>{s.name}</a></li>)}</ul>
    </nav>
  </PageHero>

  <div class="section">
    <div class="wrap list">
      {
        solutions.map((s, i) => (
          <section id={s.id} class:list={['solution', { alt: i % 2 === 1 }]} aria-labelledby={`${s.id}-title`}>
            <div class="intro">
              <span class="icon-badge">
                <Icon name={s.icon} size={32} />
              </span>
              <h2 id={`${s.id}-title`}>{s.name}</h2>
              <p class="lead">{s.summary}</p>
              <a class="btn btn--primary" href="/contact">
                Contact Us<span class="sr-only"> about {s.name}</span>
              </a>
            </div>
            <div class="features">
              <h3 class="meta">{s.listLabel}</h3>
              <ul class="check-list">
                {s.items.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </div>
          </section>
        ))
      }
    </div>
  </div>

  <CtaBand />
</Base>

<style>
  .jump ul {
    list-style: none;
    padding: 0;
    margin: 1.5rem 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .jump a {
    display: inline-block;
    padding: 0.5rem 1rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--white);
    color: var(--ink);
    text-decoration: none;
    font-weight: 600;
  }
  .jump a:hover {
    border-color: var(--brand);
    color: var(--brand);
  }
  .list {
    display: grid;
    gap: clamp(1.5rem, 3vw, 2rem);
  }
  .solution {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: clamp(1.5rem, 5vw, 4rem);
    padding: clamp(1.75rem, 4vw, 3rem);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow);
    background: var(--white);
    scroll-margin-top: 6rem;
  }
  .solution.alt {
    background: var(--surface);
  }
  .icon-badge {
    color: var(--brand);
    width: 60px;
    height: 60px;
  }
  .lead {
    margin-bottom: 1.5rem;
  }
  .meta {
    font-size: 0.8rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 1rem;
  }
  .features .check-list {
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    column-gap: 1.5rem;
  }
  @media (max-width: 820px) {
    .solution {
      grid-template-columns: 1fr;
    }
  }
</style>
