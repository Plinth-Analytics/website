---
interface Props {
  eyebrow?: string;
  title: string;
  lead?: string;
}
const { eyebrow, title, lead } = Astro.props;
---

<section class="page-hero">
  <div class="wrap">
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h1>{title}</h1>
    {lead && <p class="lead">{lead}</p>}
    <slot />
  </div>
</section>

<style>
  .page-hero {
    padding-block: clamp(3.5rem, 8vw, 6rem) clamp(2.5rem, 5vw, 4rem);
    background:
      radial-gradient(ellipse at 90% -20%, rgb(31 86 214 / 12%), transparent 55%),
      linear-gradient(180deg, var(--surface), var(--white));
    border-bottom: 1px solid var(--line);
  }
  h1 {
    max-width: 18ch;
  }
  .lead {
    max-width: 60ch;
    margin: 0;
  }
</style>
