---
import { Image } from 'astro:assets';
import logoWhite from '../assets/brand/plinth-logo-white.png';
import { NAV, LINKEDIN_URL, CONTACT_EMAIL, LEGAL_NAME } from '../lib/site';

// Evaluated at build time, so every deploy carries the current year.
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrap">
    <div class="top">
      <div class="about">
        <a href="/" aria-label="Plinth home"><Image src={logoWhite} alt="" width={132} /></a>
        <p>
          We work at the intersection of Pharma, Real World Data, and Data Science to help our clients drive innovation
          and deliver impactful solutions.
        </p>
      </div>
      <nav aria-label="Footer">
        <h2 class="col-title">Company</h2>
        <ul>
          {NAV.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
          <li><a href="/contact">Contact Us</a></li>
        </ul>
      </nav>
      <div>
        <h2 class="col-title">Get in touch</h2>
        <ul>
          <li><a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a></li>
          <li>
            <a href={LINKEDIN_URL} rel="noopener" target="_blank" class="li">
              <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"
                ><path
                  fill="currentColor"
                  d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.34V9h3.42v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13zM7.12 20.45H3.56V9h3.56v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0z"
                ></path></svg
              >
              Follow us on LinkedIn<span class="sr-only"> (opens in a new tab)</span>
            </a>
          </li>
          <li><a href="/contact" class="btn btn--light">Schedule Discovery Session</a></li>
        </ul>
      </div>
    </div>
    <div class="legal">
      <p>© {LEGAL_NAME} {year}. All rights reserved.</p>
      <p><a href="/privacy">Privacy Policy</a></p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--navy);
    color: #c9d3e8;
    padding-block: clamp(3.5rem, 7vw, 5rem) 2rem;
    font-size: 0.98rem;
  }
  .site-footer a:not(.btn) {
    color: #e6ecf8;
    text-decoration: none;
  }
  .site-footer a:not(.btn):hover {
    color: var(--white);
    text-decoration: underline;
  }
  .top {
    display: grid;
    grid-template-columns: 1.6fr 1fr 1.2fr;
    gap: 2.5rem;
  }
  .about img {
    width: 132px;
    margin-bottom: 1.25rem;
  }
  .about p {
    max-width: 36ch;
  }
  .col-title {
    font-size: 0.8rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 1rem;
  }
  ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.7rem;
    justify-items: start;
  }
  .li {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }
  ul .btn {
    margin-top: 0.5rem;
  }
  .legal {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid rgb(255 255 255 / 12%);
    font-size: 0.9rem;
  }
  .legal p {
    margin: 0;
  }
  @media (max-width: 760px) {
    .top {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }
</style>
