---
import { Image } from 'astro:assets';
import { caseStudyUrl, formatMonth, teaser, type CaseStudy } from '../lib/case-studies';

interface Props {
  entry: CaseStudy;
  headingLevel?: 'h2' | 'h3';
  eager?: boolean;
}
const { entry, headingLevel: H = 'h3', eager = false } = Astro.props;
const { data } = entry;
---

<article class="cs-card" data-category={data.category}>
  <div class="media">
    {
      data.blogImage ? (
        <Image
          src={data.blogImage.src}
          alt=""
          widths={[400, 640, 900]}
          sizes="(max-width: 700px) 100vw, (max-width: 1100px) 50vw, 380px"
          loading={eager ? 'eager' : 'lazy'}
        />
      ) : (
        <div class="placeholder" aria-hidden="true">
          <span>{data.category}</span>
        </div>
      )
    }
  </div>
  <div class="body">
    <p class="meta">
      {data.category && <span class="pill">{data.category}</span>}
      <time datetime={data.createdOn.toISOString()}>{formatMonth(data.createdOn)}</time>
    </p>
    <H class="title">
      <a href={caseStudyUrl(entry)}>{data.title}</a>
    </H>
    <p class="teaser">{teaser(entry)}</p>
    <span class="link-arrow" aria-hidden="true">Read more</span>
  </div>
</article>

<style>
  .cs-card {
    position: relative;
    display: flex;
    flex-direction: column;
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow);
    transition:
      box-shadow 0.2s ease,
      transform 0.2s ease;
  }
  .cs-card:hover,
  .cs-card:focus-within {
    box-shadow: var(--shadow-lg);
    transform: translateY(-2px);
  }
  .media {
    aspect-ratio: 16 / 9;
    background: var(--surface);
    border-bottom: 1px solid var(--line);
    overflow: hidden;
  }
  .media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .placeholder {
    height: 100%;
    display: grid;
    place-items: center;
    background:
      radial-gradient(circle at 20% 20%, rgb(127 176 255 / 35%), transparent 50%),
      linear-gradient(135deg, var(--navy), var(--navy-2));
    color: var(--white);
    font-weight: 650;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    font-size: 0.85rem;
  }
  .body {
    padding: 1.4rem 1.5rem 1.6rem;
    display: flex;
    flex-direction: column;
    flex: 1;
  }
  .meta {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.9rem;
  }
  .title {
    font-size: 1.22rem;
    line-height: 1.3;
    margin-bottom: 0.6rem;
  }
  .title a {
    color: var(--ink);
    text-decoration: none;
  }
  /* Whole card is clickable via the heading link. */
  .title a::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
  }
  .title a:focus-visible {
    outline: none;
  }
  .cs-card:has(.title a:focus-visible) {
    outline: 3px solid var(--focus);
    outline-offset: 3px;
  }
  .teaser {
    font-size: 0.98rem;
    color: var(--muted);
    flex: 1;
  }
  .link-arrow {
    color: var(--brand);
    margin-top: 0.25rem;
  }
</style>
