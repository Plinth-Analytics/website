---
import { Image } from 'astro:assets';
import logoDark from '../assets/brand/plinth-logo-dark.png';
import logoWhite from '../assets/brand/plinth-logo-white.png';
import { NAV } from '../lib/site';

interface Props {
  tone?: 'light' | 'dark';
}
const { tone = 'light' } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, '');
const isCurrent = (href: string) => path === href || path.startsWith(href + '/');
---

<header class:list={['site-header', `site-header--${tone}`]} data-header>
  <div class="wrap bar">
    <a href="/" class="brand" aria-label="Plinth home">
      <Image src={tone === 'dark' ? logoWhite : logoDark} alt="" width={132} loading="eager" />
    </a>

    <nav aria-label="Main">
      <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-menu" data-menu-toggle>
        <span class="sr-only">Menu</span>
        <svg width="24" height="24" viewBox="0 0 24 24" aria-hidden="true"
          ><path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path></svg
        >
      </button>
      <ul id="site-menu" class="menu" data-menu>
        {
          NAV.map((item) => (
            <li>
              <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
        <li class="menu-cta">
          <a class="btn btn--primary" href="/contact" aria-current={isCurrent('/contact') ? 'page' : undefined}>
            Contact Us
          </a>
        </li>
      </ul>
    </nav>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const setOpen = (open: boolean) => {
    toggle?.setAttribute('aria-expanded', String(open));
    header?.classList.toggle('is-open', open);
  };
  toggle?.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
  document.addEventListener('keydown', (e) => e.key === 'Escape' && setOpen(false));
  const onScroll = () => header?.classList.toggle('is-scrolled', window.scrollY > 8);
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgb(255 255 255 / 92%);
    backdrop-filter: saturate(1.4) blur(10px);
    border-bottom: 1px solid transparent;
    transition:
      border-color 0.2s ease,
      background-color 0.2s ease;
  }
  .site-header.is-scrolled {
    border-bottom-color: var(--line);
  }
  /* Dark tone sits over the home hero, then turns light once the page scrolls. */
  .site-header--dark {
    position: fixed;
    inset: 0 0 auto;
    background: transparent;
  }
  .site-header--dark:not(.is-scrolled, .is-open) .menu a:not(.btn) {
    color: var(--white);
  }
  .site-header--dark:not(.is-scrolled, .is-open) .menu-toggle {
    color: var(--white);
  }
  .site-header--dark.is-scrolled,
  .site-header--dark.is-open {
    background: var(--navy);
    border-bottom-color: rgb(255 255 255 / 10%);
  }
  .site-header--dark :is(.is-scrolled, .is-open) .menu a:not(.btn),
  .site-header--dark.is-scrolled .menu a:not(.btn),
  .site-header--dark.is-open .menu a:not(.btn) {
    color: var(--white);
  }
  .site-header--dark .menu-toggle {
    color: var(--white);
  }

  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 76px;
    gap: 1rem;
  }
  .brand {
    display: block;
    flex-shrink: 0;
  }
  .brand img {
    width: 132px;
    height: auto;
  }
  .menu {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    align-items: center;
    gap: clamp(1rem, 2.4vw, 2.1rem);
  }
  .menu a:not(.btn) {
    color: var(--ink);
    text-decoration: none;
    font-weight: 550;
    padding: 0.4rem 0;
    border-bottom: 2px solid transparent;
  }
  .menu a:not(.btn):hover,
  .menu a[aria-current='page']:not(.btn) {
    border-bottom-color: currentColor;
  }
  .menu-cta .btn {
    min-height: 42px;
    padding: 0.55rem 1.15rem;
  }
  .menu-toggle {
    display: none;
    background: none;
    border: 0;
    color: var(--ink);
    padding: 0.6rem;
    margin-right: -0.6rem;
    cursor: pointer;
  }

  @media (max-width: 860px) {
    .menu-toggle {
      display: block;
    }
    .menu {
      display: none;
      position: absolute;
      inset: 100% 0 auto;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      padding: 0.5rem var(--gutter) 1.5rem;
      background: var(--white);
      border-bottom: 1px solid var(--line);
      box-shadow: var(--shadow-lg);
    }
    .site-header--dark .menu {
      background: var(--navy);
      border-bottom-color: rgb(255 255 255 / 10%);
    }
    .is-open .menu {
      display: flex;
    }
    .menu a:not(.btn) {
      display: block;
      padding: 0.9rem 0;
      border-bottom: 1px solid var(--line);
    }
    .site-header--dark .menu a:not(.btn) {
      border-bottom-color: rgb(255 255 255 / 12%);
    }
    .menu-cta {
      margin-top: 1rem;
    }
    .menu-cta .btn {
      width: 100%;
    }
  }
  /* No JS: keep the menu reachable on small screens. */
  @media (max-width: 860px) {
    :global(html:not(.js)) .menu-toggle {
      display: none;
    }
    :global(html:not(.js)) .menu {
      display: flex;
      position: static;
      flex-direction: row;
      flex-wrap: wrap;
      box-shadow: none;
      padding: 0 0 0.75rem;
      gap: 0.25rem 1rem;
      background: transparent;
      border: 0;
    }
    :global(html:not(.js)) .bar {
      flex-wrap: wrap;
    }
  }
</style>
